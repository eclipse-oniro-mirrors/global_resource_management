# source code for win.
is_mingw = "${current_os}_${current_cpu}" == "mingw_x86_64"

# source code for linux.
is_linux = "${current_os}_${current_cpu}" == "linux_x64"

# source code for mac.
is_mac = "${current_os}_${current_cpu}" == "mac_x64" ||
         "${current_os}_${host_cpu}" == "mac_arm64"

ability_runtime_path = "//foundation/ability/ability_runtime"

declare_args() {
  resource_management_support_icu = true

  if (defined(global_parts_info) && defined(global_parts_info.hiviewdfx_api_metrics)) {
    resource_management_api_metrics = true
  } else {
    resource_management_api_metrics = false
  }
}

